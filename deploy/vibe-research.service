[Unit]
Description=Vibe Research orchestrator API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/vibe-research/app
EnvironmentFile=/etc/vibe-research/vibe-research.env
ExecStart=/usr/bin/node orchestrator/src/api.ts --host 127.0.0.1 --port 8092
Restart=always
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/vibe-research/shared/.local
UMask=0077
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
