[Unit]
Description=Nova 本地第三方调研消息原文同步（禁止向线上推送）
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/.local/lib/vibe-research-dingtalk
EnvironmentFile=%h/.config/vibe-research/dingtalk.env
ExecStart=/usr/bin/node %h/.local/lib/vibe-research-dingtalk/sync-dingtalk-group.mjs
UMask=0077
StandardOutput=journal
StandardError=journal
