[Unit]
Description=Vibe Research GPU rent incremental refresh
After=vibe-research.service
Requires=vibe-research.service

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/vibe-research/app
EnvironmentFile=/etc/vibe-research/vibe-research.env
ExecStart=/usr/bin/node /opt/vibe-research/app/scripts/refresh-gpu.mjs
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/vibe-research/shared/.local
UMask=0077
StandardOutput=journal
StandardError=journal
